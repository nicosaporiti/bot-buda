# Buda.com API Credentials
# Get your API keys from: https://www.buda.com/api-keys

BUDA_API_KEY=your_api_key_here
BUDA_API_SECRET=your_api_secret_here

# Quote currency for market pairs (default: clp)
# Options: clp, cop, pen
BUDA_QUOTE_CURRENCY=clp

# Optional assistant (text and voice); menus work without this key
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
